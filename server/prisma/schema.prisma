// This is your Prisma schema file for CareConnect
// BRD Tech Stack: MySQL 8.x + Prisma ORM
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & ACCESS CONTROL
// ============================================================

model User {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  isVerified   Boolean   @default(false) @map("is_verified")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles     UserRole[]
  patient       Patient?
  doctor        Doctor?
  refreshTokens RefreshToken[]
  otpRecords    OtpRecord[]
  auditLogs     AuditLog[]
  reviewedDocs  DoctorDocument[] @relation("DocumentReviewer")
  complaints    Complaint[]      @relation("ComplaintAssignee")

  @@map("users")
}

model Role {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  userRoles UserRole[]
  rolePerms RolePermission[]

  @@map("roles")
}

model Permission {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  rolePerms RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpRecord {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   // EMAIL_VERIFY, PHONE_VERIFY, LOGIN, PASSWORD_RESET
  otp       String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_records")
}

// ============================================================
// ORGANIZATIONS & MULTI-TENANT
// ============================================================

model SubscriptionPlan {
  id            Int            @id @default(autoincrement())
  name          String
  doctorLimit   Int?           @map("doctor_limit")
  patientLimit  Int?           @map("patient_limit")
  features      Json?
  priceMonthly  Decimal        @map("price_monthly") @db.Decimal(10, 2)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  organizations Organization[]

  @@map("subscription_plans")
}

model Organization {
  id        Int               @id @default(autoincrement())
  name      String
  subdomain String            @unique
  planId    Int?              @map("plan_id")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  plan      SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@map("organizations")
}

// ============================================================
// PATIENTS
// ============================================================

model Patient {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  name             String
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?
  bloodGroup       String?  @map("blood_group")
  address          String?  @db.Text
  city             String?
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  emergencyContact String?  @map("emergency_contact")
  organizationId   Int?     @map("organization_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  emergencyReqs  EmergencyRequest[]
  payments       Payment[]
  medicalRecords MedicalRecord[]
  familyMembers  FamilyMember[]
  reviews        Review[]
  complaints     Complaint[]

  @@map("patients")
}

model FamilyMember {
  id          Int       @id @default(autoincrement())
  patientId   Int       @map("patient_id")
  name        String
  relation    String
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  bloodGroup  String?   @map("blood_group")
  createdAt   DateTime  @default(now()) @map("created_at")
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("family_members")
}

// ============================================================
// DOCTORS
// ============================================================

model Doctor {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @unique @map("user_id")
  name                   String
  phone                  String?
  gender                 String?
  profileImage           String?   @map("profile_image")
  bio                    String?   @db.Text
  medicalRegNumber       String?   @unique @map("medical_reg_number")
  verificationStatus     String    @default("PENDING") @map("verification_status")
  isOnline               Boolean   @default(false) @map("is_online")
  isAvailable            Boolean   @default(false) @map("is_available")
  isEmergencyAvailable   Boolean   @default(false) @map("is_emergency_available")
  serviceRadiusKm        Decimal?  @map("service_radius_km") @db.Decimal(5, 2)
  currentLatitude        Decimal?  @map("current_latitude") @db.Decimal(10, 8)
  currentLongitude       Decimal?  @map("current_longitude") @db.Decimal(11, 8)
  consultationFee        Decimal?  @map("consultation_fee") @db.Decimal(10, 2)
  homeVisitFee           Decimal?  @map("home_visit_fee") @db.Decimal(10, 2)
  emergencyFee           Decimal?  @map("emergency_fee") @db.Decimal(10, 2)
  experienceYears        Int?      @map("experience_years")
  rating                 Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews           Int       @default(0) @map("total_reviews")
  organizationId         Int?      @map("organization_id")
  kycApprovedAt          DateTime? @map("kyc_approved_at")
  bankAccountNumber      String?   @map("bank_account_number")
  bankIfsc               String?   @map("bank_ifsc")
  bankAccountName        String?   @map("bank_account_name")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations      DoctorSpecialization[]
  documents            DoctorDocument[]
  availability         DoctorAvailability[]
  vacationBlocks       VacationBlock[]
  appointments         Appointment[]
  emergencyAssignments EmergencyAssignment[]
  wallet               DoctorWallet?
  handoverFrom         HandoverRequest[]     @relation("HandoverFrom")
  handoverTo           HandoverRequest[]     @relation("HandoverTo")
  prescriptions        Prescription[]
  reviews              Review[]

  @@index([verificationStatus])
  @@index([isAvailable, isEmergencyAvailable])
  @@index([currentLatitude, currentLongitude])
  @@map("doctors")
}

model DoctorSpecialization {
  id             Int    @id @default(autoincrement())
  doctorId       Int    @map("doctor_id")
  specialization String
  doctor         Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([specialization])
  @@map("doctor_specializations")
}

model DoctorDocument {
  id         Int       @id @default(autoincrement())
  doctorId   Int       @map("doctor_id")
  type       String    // DEGREE, LICENSE, KYC_ID, KYC_SELFIE, BANK_PASSBOOK, OTHER
  fileUrl    String    @map("file_url") @db.VarChar(500)
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNote String?   @map("review_note") @db.Text
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy Int?      @map("reviewed_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("DocumentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([status])
  @@map("doctor_documents")
}

model DoctorAvailability {
  id         Int     @id @default(autoincrement())
  doctorId   Int     @map("doctor_id")
  dayOfWeek  Int     @map("day_of_week") // 0=Sunday...6=Saturday
  startTime  String  @map("start_time")  // "09:00"
  endTime    String  @map("end_time")    // "18:00"
  isActive   Boolean @default(true) @map("is_active")
  doctor     Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("doctor_availability")
}

model VacationBlock {
  id        Int      @id @default(autoincrement())
  doctorId  Int      @map("doctor_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("vacation_blocks")
}

// ============================================================
// EMERGENCY
// ============================================================

model EmergencyRequest {
  id           Int      @id @default(autoincrement())
  patientId    Int      @map("patient_id")
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  medicalNeeds String?  @map("medical_needs") @db.Text
  status       String   @default("SEARCHING")
  escalatedAt  DateTime? @map("escalated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient     Patient               @relation(fields: [patientId], references: [id])
  assignments EmergencyAssignment[]

  @@index([status])
  @@index([patientId])
  @@map("emergency_requests")
}

model EmergencyAssignment {
  id                 Int      @id @default(autoincrement())
  emergencyRequestId Int      @map("emergency_request_id")
  doctorId           Int      @map("doctor_id")
  notifiedAt         DateTime @default(now()) @map("notified_at")
  respondedAt        DateTime? @map("responded_at")
  status             String   @default("NOTIFIED") // NOTIFIED, ACCEPTED, REJECTED, TIMEOUT
  timeoutAt          DateTime @map("timeout_at")

  request EmergencyRequest @relation(fields: [emergencyRequestId], references: [id])
  doctor  Doctor           @relation(fields: [doctorId], references: [id])

  @@index([emergencyRequestId])
  @@index([doctorId])
  @@index([status])
  @@map("emergency_assignments")
}

// ============================================================
// APPOINTMENTS & VISITS
// ============================================================

model Appointment {
  id           Int       @id @default(autoincrement())
  patientId    Int       @map("patient_id")
  doctorId     Int       @map("doctor_id")
  serviceType  String    @default("NORMAL") @map("service_type")
  scheduledAt  DateTime? @map("scheduled_at")
  status       String    @default("REQUESTED")
  cancelReason String?   @map("cancel_reason") @db.Text
  notes        String?   @db.Text
  tokenNumber  String?   @map("token_number")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  patient   Patient          @relation(fields: [patientId], references: [id])
  doctor    Doctor           @relation(fields: [doctorId], references: [id])
  payment   Payment?
  visit     Visit?
  handovers HandoverRequest[]
  review    Review?
  conversation Conversation?

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

model Visit {
  id              Int       @id @default(autoincrement())
  appointmentId   Int       @unique @map("appointment_id")
  doctorLatitude  Decimal?  @map("doctor_latitude") @db.Decimal(10, 8)
  doctorLongitude Decimal?  @map("doctor_longitude") @db.Decimal(11, 8)
  arrivedAt       DateTime? @map("arrived_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  doctorNotes     String?   @map("doctor_notes") @db.Text
  followUpDate    DateTime? @map("follow_up_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  appointment   Appointment      @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
  documents     MedicalDocument[]

  @@map("visits")
}

model HandoverRequest {
  id              Int      @id @default(autoincrement())
  appointmentId   Int      @map("appointment_id")
  fromDoctorId    Int      @map("from_doctor_id")
  toDoctorId      Int?     @map("to_doctor_id")
  reason          String
  status          String   @default("PENDING")
  patientNotified Boolean  @default(false) @map("patient_notified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  fromDoctor  Doctor      @relation("HandoverFrom", fields: [fromDoctorId], references: [id])
  toDoctor    Doctor?     @relation("HandoverTo", fields: [toDoctorId], references: [id])

  @@index([appointmentId])
  @@index([status])
  @@map("handover_requests")
}

// ============================================================
// PAYMENTS & FINANCE
// ============================================================

model Payment {
  id                Int       @id @default(autoincrement())
  appointmentId     Int       @unique @map("appointment_id")
  patientId         Int       @map("patient_id")
  grossAmount       Decimal   @map("gross_amount") @db.Decimal(12, 2)
  platformFee       Decimal   @default(0) @map("platform_fee") @db.Decimal(12, 2)
  taxAmount         Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  doctorPayable     Decimal   @map("doctor_payable") @db.Decimal(12, 2)
  gatewayOrderId    String?   @unique @map("gateway_order_id")
  gatewayPaymentId  String?   @unique @map("gateway_payment_id")
  gatewaySignature  String?   @map("gateway_signature") @db.VarChar(512)
  status            String    @default("INITIATED")
  capturedAt        DateTime? @map("captured_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  appointment  Appointment        @relation(fields: [appointmentId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  refunds      Refund[]
  transaction  WalletTransaction?

  @@index([status])
  @@index([patientId])
  @@map("payments")
}

model Refund {
  id            Int       @id @default(autoincrement())
  paymentId     Int       @map("payment_id")
  amount        Decimal   @db.Decimal(12, 2)
  reason        String    @db.Text
  initiatedBy   String    @map("initiated_by")
  gatewayRefId  String?   @map("gateway_ref_id")
  status        String    @default("PENDING")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model DoctorWallet {
  id               Int      @id @default(autoincrement())
  doctorId         Int      @unique @map("doctor_id")
  totalEarnings    Decimal  @default(0) @map("total_earnings") @db.Decimal(14, 2)
  pendingBalance   Decimal  @default(0) @map("pending_balance") @db.Decimal(14, 2)
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(14, 2)
  withdrawnAmount  Decimal  @default(0) @map("withdrawn_amount") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  doctor       Doctor             @relation(fields: [doctorId], references: [id])
  transactions WalletTransaction[]
  settlements  Settlement[]
  withdrawals  Withdrawal[]

  @@map("doctor_wallets")
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  walletId    Int      @map("wallet_id")
  paymentId   Int?     @unique @map("payment_id")
  type        String   // CREDIT, DEBIT, HOLD, RELEASE, WITHDRAWAL
  amount      Decimal  @db.Decimal(12, 2)
  description String?  @db.VarChar(500)
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  wallet  DoctorWallet @relation(fields: [walletId], references: [id])
  payment Payment?     @relation(fields: [paymentId], references: [id])

  @@index([walletId])
  @@index([type])
  @@map("wallet_transactions")
}

model Settlement {
  id         Int       @id @default(autoincrement())
  walletId   Int       @map("wallet_id")
  amount     Decimal   @db.Decimal(12, 2)
  holdUntil  DateTime  @map("hold_until")
  releasedAt DateTime? @map("released_at")
  status     String    @default("HOLDING") // HOLDING, RELEASED, FAILED
  createdAt  DateTime  @default(now()) @map("created_at")

  wallet DoctorWallet @relation(fields: [walletId], references: [id])

  @@index([status])
  @@index([holdUntil])
  @@map("settlements")
}

model Withdrawal {
  id            Int       @id @default(autoincrement())
  walletId      Int       @map("wallet_id")
  amount        Decimal   @db.Decimal(12, 2)
  bankAccount   String?   @map("bank_account")
  ifscCode      String?   @map("ifsc_code")
  utrNumber     String?   @map("utr_number")
  status        String    @default("REQUESTED")
  rejectReason  String?   @map("reject_reason") @db.VarChar(500)
  requestedAt   DateTime  @default(now()) @map("requested_at")
  processedAt   DateTime? @map("processed_at")

  wallet DoctorWallet @relation(fields: [walletId], references: [id])

  @@index([status])
  @@index([walletId])
  @@map("withdrawals")
}

// ============================================================
// MEDICAL DATA
// ============================================================

model Prescription {
  id        Int      @id @default(autoincrement())
  visitId   Int      @map("visit_id")
  doctorId  Int      @map("doctor_id")
  medicines Json?
  notes     String?  @db.Text
  pdfUrl    String?  @map("pdf_url") @db.VarChar(500)
  signature String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  visit  Visit  @relation(fields: [visitId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([visitId])
  @@map("prescriptions")
}

model MedicalDocument {
  id        Int      @id @default(autoincrement())
  visitId   Int      @map("visit_id")
  type      String
  fileUrl   String   @map("file_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id])

  @@map("medical_documents")
}

model MedicalRecord {
  id         Int      @id @default(autoincrement())
  patientId  Int      @map("patient_id")
  title      String
  recordType String   @map("record_type")
  fileUrl    String?  @map("file_url") @db.VarChar(500)
  notes      String?  @db.Text
  recordedAt DateTime @map("recorded_at") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_records")
}

// ============================================================
// COMMUNICATION
// ============================================================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  body      String   @db.Text
  type      String
  entityId  Int?     @map("entity_id")
  isRead    Boolean  @default(false) @map("is_read")
  channels  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Conversation {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique @map("appointment_id")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  messages    Message[]

  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  senderId       Int      @map("sender_id")
  type           String   @default("TEXT")
  content        String   @db.Text
  fileUrl        String?  @map("file_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// ============================================================
// REVIEWS & COMPLAINTS
// ============================================================

model Review {
  id            Int      @id @default(autoincrement())
  patientId     Int      @map("patient_id")
  doctorId      Int      @map("doctor_id")
  appointmentId Int      @unique @map("appointment_id")
  rating        Int
  review        String?  @db.Text
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")

  patient     Patient     @relation(fields: [patientId], references: [id])
  doctor      Doctor      @relation(fields: [doctorId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([doctorId])
  @@map("reviews")
}

model Complaint {
  id          Int       @id @default(autoincrement())
  patientId   Int       @map("patient_id")
  category    String
  description String    @db.Text
  status      String    @default("OPEN")
  assignedTo  Int?      @map("assigned_to")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  patient  Patient @relation(fields: [patientId], references: [id])
  assignee User?   @relation("ComplaintAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("complaints")
}

// ============================================================
// AUDIT LOGS & SYSTEM SETTINGS
// ============================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  userRole  String?  @map("user_role")
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  prevValue Json?    @map("prev_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
