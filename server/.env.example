# ========================
# SERVER
# ========================
PORT=5000
NODE_ENV=development

# ========================
# DATABASE (MySQL Workbench)
# ========================
DATABASE_URL="mysql://root:yourpassword@localhost:3306/careconnect_db"

# ========================
# JWT
# ========================
JWT_ACCESS_SECRET=your_access_secret_here_change_this
JWT_REFRESH_SECRET=your_refresh_secret_here_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# REDIS
# ========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# RAZORPAY
# ========================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ========================
# TWILIO (SMS/WhatsApp)
# ========================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ========================
# EMAIL (SMTP)
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@careconnect.in

# ========================
# S3 / CLOUDINARY
# ========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================
# SENTRY
# ========================
SENTRY_DSN=your_sentry_dsn_here

# ========================
# PLATFORM SETTINGS
# ========================
PLATFORM_COMMISSION_PCT=15
SETTLEMENT_HOLD_HOURS=24
EMERGENCY_TIMEOUT_SECONDS=60
CLIENT_URL=http://localhost:3000
